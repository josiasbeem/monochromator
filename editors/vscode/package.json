{
  "name": "monochromator",
  "displayName": "Monochromator",
  "description": "Distraction-free monochrome coding theme",
  "version": "0.35.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monochrome",
    "monochromatic",
    "minimal",
    "minimalist",
    "minimalism",
    "black and white",
    "grayscale",
    "greyscale",
    "contrast",
    "clean",
    "focus",
    "simple"
  ],
  "publisher": "beem",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/josiasbeem/monochromator.git"
  },
  "bugs": {
    "url": "https://github.com/josiasbeem/monochromator/issues",
    "email": "josias@beem.at"
  },
  "contributes": {
    "themes": [
      {
        "label": "Monochromator Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dark/default.json"
      },
      {
        "label": "Monochromator Dark Amber",
        "uiTheme": "vs-dark",
        "path": "./themes/dark/amber.json"
      },
      {
        "label": "Monochromator Dark Amethyst",
        "uiTheme": "vs-dark",
        "path": "./themes/dark/amethyst.json"
      },
      {
        "label": "Monochromator Dark Aquamarine",
        "uiTheme": "vs-dark",
        "path": "./themes/dark/aquamarine.json"
      },
      {
        "label": "Monochromator Dark Emerald",
        "uiTheme": "vs-dark",
        "path": "./themes/dark/emerald.json"
      },
      {
        "label": "Monochromator Dark Plain",
        "uiTheme": "vs-dark",
        "path": "./themes/dark/plain.json"
      },
      {
        "label": "Monochromator Dark Ruby",
        "uiTheme": "vs-dark",
        "path": "./themes/dark/ruby.json"
      },
      {
        "label": "Monochromator Dark Sulfur",
        "uiTheme": "vs-dark",
        "path": "./themes/dark/sulfur.json"
      },
      {
        "label": "Monochromator Light",
        "uiTheme": "vs",
        "path": "./themes/light/default.json"
      },
      {
        "label": "Monochromator Light Amber",
        "uiTheme": "vs",
        "path": "./themes/light/amber.json"
      },
      {
        "label": "Monochromator Light Amethyst",
        "uiTheme": "vs",
        "path": "./themes/light/amethyst.json"
      },
      {
        "label": "Monochromator Light Aquamarine",
        "uiTheme": "vs",
        "path": "./themes/light/aquamarine.json"
      },
      {
        "label": "Monochromator Light Emerald",
        "uiTheme": "vs",
        "path": "./themes/light/emerald.json"
      },
      {
        "label": "Monochromator Light Plain",
        "uiTheme": "vs",
        "path": "./themes/light/plain.json"
      },
      {
        "label": "Monochromator Light Ruby",
        "uiTheme": "vs",
        "path": "./themes/light/ruby.json"
      },
      {
        "label": "Monochromator Light Sulfur",
        "uiTheme": "vs",
        "path": "./themes/light/sulfur.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "monochromator.injection.rust",
        "path": "./syntaxes/rust.json",
        "injectTo": [
          "source.rust"
        ]
      },
      {
        "scopeName": "monochromator.injection.rust-string",
        "path": "./syntaxes/rust-string.json",
        "injectTo": [
          "source.rust"
        ]
      },
      {
        "scopeName": "monochromator.injection.rust-variants",
        "path": "./syntaxes/rust-variants.json",
        "injectTo": [
          "source.rust"
        ]
      },
      {
        "scopeName": "monochromator.injection.rust-self",
        "path": "./syntaxes/rust-self.json",
        "injectTo": [
          "source.rust"
        ]
      },
      {
        "scopeName": "monochromator.injection.c",
        "path": "./syntaxes/c.json",
        "injectTo": [
          "source.c"
        ]
      },
      {
        "scopeName": "monochromator.injection.java",
        "path": "./syntaxes/java.json",
        "injectTo": [
          "source.java"
        ]
      },
      {
        "scopeName": "monochromator.injection.java-import",
        "path": "./syntaxes/java-import.json",
        "injectTo": [
          "source.java"
        ]
      },
      {
        "scopeName": "monochromator.injection.java-string",
        "path": "./syntaxes/java-string.json",
        "injectTo": [
          "source.java"
        ]
      },
      {
        "scopeName": "monochromator.injection.java-this",
        "path": "./syntaxes/java-this.json",
        "injectTo": [
          "source.java"
        ]
      },
      {
        "scopeName": "monochromator.injection.csharp-this",
        "path": "./syntaxes/csharp-this.json",
        "injectTo": [
          "source.cs"
        ]
      },
      {
        "scopeName": "monochromator.injection.latex",
        "path": "./syntaxes/latex.json",
        "injectTo": [
          "text.tex.latex",
          "text.tex"
        ]
      },
      {
        "scopeName": "monochromator.injection.latex-math",
        "path": "./syntaxes/latex-math.json",
        "injectTo": [
          "text.tex.latex",
          "text.tex"
        ]
      },
      {
        "scopeName": "monochromator.injection.cpp",
        "path": "./syntaxes/cpp.json",
        "injectTo": [
          "source.cpp"
        ]
      },
      {
        "scopeName": "monochromator.injection.cpp-this",
        "path": "./syntaxes/cpp-this.json",
        "injectTo": [
          "source.cpp"
        ]
      },
      {
        "scopeName": "monochromator.injection.shell",
        "path": "./syntaxes/shell.json",
        "injectTo": [
          "source.shell"
        ]
      },
      {
        "scopeName": "monochromator.injection.zig",
        "path": "./syntaxes/zig.json",
        "injectTo": [
          "source.zig"
        ]
      },
      {
        "scopeName": "monochromator.injection.typescript",
        "path": "./syntaxes/typescript.json",
        "injectTo": [
          "source.ts"
        ]
      },
      {
        "scopeName": "monochromator.injection.typescriptreact",
        "path": "./syntaxes/typescriptreact.json",
        "injectTo": [
          "source.tsx"
        ]
      },
      {
        "scopeName": "monochromator.injection.typescript-this",
        "path": "./syntaxes/typescript-this.json",
        "injectTo": [
          "source.ts"
        ]
      },
      {
        "scopeName": "monochromator.injection.typescript-this-call",
        "path": "./syntaxes/typescript-this-call.json",
        "injectTo": [
          "source.ts"
        ]
      },
      {
        "scopeName": "monochromator.injection.typescriptreact-this",
        "path": "./syntaxes/typescriptreact-this.json",
        "injectTo": [
          "source.tsx"
        ]
      },
      {
        "scopeName": "monochromator.injection.typescriptreact-this-call",
        "path": "./syntaxes/typescriptreact-this-call.json",
        "injectTo": [
          "source.tsx"
        ]
      },
      {
        "scopeName": "monochromator.injection.javascript-this",
        "path": "./syntaxes/javascript-this.json",
        "injectTo": [
          "source.js"
        ]
      },
      {
        "scopeName": "monochromator.injection.javascript-this-call",
        "path": "./syntaxes/javascript-this-call.json",
        "injectTo": [
          "source.js"
        ]
      },
      {
        "scopeName": "monochromator.injection.javascriptreact-this",
        "path": "./syntaxes/javascriptreact-this.json",
        "injectTo": [
          "source.js.jsx"
        ]
      },
      {
        "scopeName": "monochromator.injection.javascriptreact-this-call",
        "path": "./syntaxes/javascriptreact-this-call.json",
        "injectTo": [
          "source.js.jsx"
        ]
      },
      {
        "scopeName": "monochromator.injection.regexp",
        "path": "./syntaxes/regexp.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx"
        ]
      },
      {
        "scopeName": "monochromator.injection.swift",
        "path": "./syntaxes/swift.json",
        "injectTo": [
          "source.swift"
        ]
      },
      {
        "scopeName": "monochromator.injection.swift-interpolation",
        "path": "./syntaxes/swift-interpolation.json",
        "injectTo": [
          "source.swift"
        ]
      },
      {
        "scopeName": "monochromator.injection.julia",
        "path": "./syntaxes/julia.json",
        "injectTo": [
          "source.julia"
        ]
      },
      {
        "scopeName": "monochromator.injection.dart",
        "path": "./syntaxes/dart.json",
        "injectTo": [
          "source.dart"
        ]
      },
      {
        "scopeName": "monochromator.injection.groovy",
        "path": "./syntaxes/groovy.json",
        "injectTo": [
          "source.groovy"
        ]
      },
      {
        "scopeName": "monochromator.injection.groovy-interpolation",
        "path": "./syntaxes/groovy-interpolation.json",
        "injectTo": [
          "source.groovy"
        ]
      },
      {
        "scopeName": "monochromator.injection.python",
        "path": "./syntaxes/python.json",
        "injectTo": [
          "source.python"
        ]
      }
    ]
  }
}
