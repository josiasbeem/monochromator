{
	"scopeName": "monochromator.injection.typescript-this-call",
	"injectionSelector": "L:meta.function-call.ts",
	"patterns": [
		{
			"match": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))this\\b(?!\\$)(?=\\s*\\()",
			"name": "meta.constructor.monochromator variable.language.this.ts"
		},
		{
			"match": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))super\\b(?!\\$)(?=\\s*\\()",
			"name": "meta.constructor.monochromator variable.language.super.ts"
		}
	]
}
