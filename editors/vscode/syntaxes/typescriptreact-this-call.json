{
	"scopeName": "monochromator.injection.typescriptreact-this-call",
	"injectionSelector": "L:meta.function-call.tsx",
	"patterns": [
		{
			"match": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))this\\b(?!\\$)(?=\\s*\\()",
			"name": "meta.constructor.monochromator variable.language.this.tsx"
		},
		{
			"match": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))super\\b(?!\\$)(?=\\s*\\()",
			"name": "meta.constructor.monochromator variable.language.super.tsx"
		}
	]
}
