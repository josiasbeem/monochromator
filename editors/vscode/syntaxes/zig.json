{
	"scopeName": "monochromator.injection.zig",
	"injectionSelector": "L:source.zig - (comment | string | variable.string)",
	"patterns": [
		{
			"match": "\\b(error)(?:(\\.)(\\w+))?\\b",
			"captures": {
				"1": {
					"name": "meta.keyword.monochromator keyword.type.zig"
				},
				"2": {
					"name": "punctuation.accessor.zig"
				},
				"3": {
					"name": "entity.name.error.zig"
				}
			}
		}
	]
}
